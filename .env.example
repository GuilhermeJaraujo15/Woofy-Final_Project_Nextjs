# Copy this file to .env.local for local development.
# On Vercel, configure these variables before building in Production/Preview.
# https://supabase.com/dashboard/project/_/settings/api
# Use the project URL and a public key from the SAME Supabase project.
# Never use a secret key or service_role key in NEXT_PUBLIC_ variables.

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy alternative: omit PUBLISHABLE_KEY above and use ANON_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
